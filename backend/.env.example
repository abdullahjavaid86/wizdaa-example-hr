# API Gateway
GATEWAY_PORT=3000
NODE_ENV=development
DEBUG=true

# JWT
JWT_SECRET=change_me_to_a_long_random_secret_in_production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# HCM Webhook Auth
HCM_WEBHOOK_SECRET=change_me_to_a_webhook_secret

# CORS
FRONTEND_URL=http://localhost:5173

# Time-Off Microservice
TIME_OFF_TCP_HOST=localhost
TIME_OFF_TCP_PORT=3001

# HCM Mock
HCM_BASE_URL=http://localhost:3002
HCM_MOCK_PORT=3002
HCM_API_KEY=mock-api-key-for-development

# SQLite paths (relative to app root, overridden in test)
TIMEOFF_DB_PATH=time_off.db
HCM_DB_PATH=hcm_mock.db
