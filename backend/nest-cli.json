{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/api-gateway/src",
  "monorepo": true,
  "root": "apps/api-gateway",
  "compilerOptions": {
    "tsConfigPath": "apps/api-gateway/tsconfig.app.json",
    "plugins": ["@nestjs/swagger"]
  },
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-gateway/tsconfig.app.json",
        "plugins": ["@nestjs/swagger"]
      }
    },
    "time-off": {
      "type": "application",
      "root": "apps/time-off",
      "entryFile": "main",
      "sourceRoot": "apps/time-off/src",
      "compilerOptions": {
        "tsConfigPath": "apps/time-off/tsconfig.app.json"
      }
    },
    "hcm-mock": {
      "type": "application",
      "root": "apps/hcm-mock",
      "entryFile": "main",
      "sourceRoot": "apps/hcm-mock/src",
      "compilerOptions": {
        "tsConfigPath": "apps/hcm-mock/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    }
  }
}
